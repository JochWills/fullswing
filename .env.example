# ---- Site ----
# Public URL of the site (no trailing slash). Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase (Project Settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only - never expose. Used for bookings, payments and admin writes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Admin ----
# Comma-separated emails allowed into /admin (sign up with this email first)
ADMIN_EMAILS=joshiewilliams2003@gmail.com

# ---- Paystack (Settings -> API Keys & Webhooks) ----
# Use sk_test_... until your account is approved, then swap to sk_live_...
PAYSTACK_SECRET_KEY=sk_test_xxx

# ---- Email ----
# Option A (no domain needed): a Gmail account with an app password
#   Google Account -> Security -> 2-Step Verification on -> App passwords -> create one
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Option B: Resend (https://resend.com) - needs your own domain to email clients
RESEND_API_KEY=
# Sender shown to clients. With Gmail it must be the same Gmail address.
# Leave everything blank to skip emails (they are logged to the console instead).
EMAIL_FROM="Full-Swing Tennis Academy <you@gmail.com>"
# Where you get notified of new bookings
ADMIN_NOTIFY_EMAIL=joshiewilliams2003@gmail.com

# ---- Google Calendar (Google Cloud Console -> OAuth client, type Web) ----
# Authorised redirect URI: {NEXT_PUBLIC_SITE_URL}/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Cron ----
# Random long string. The Render cron job sends it to /api/cron/reminders
CRON_SECRET=change-me-to-a-long-random-string

# ---- Testing without Paystack ----
# true = bookings are confirmed immediately without payment (for testing only!)
PAYMENTS_TEST_MODE=true
